<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drive PDF Watermarker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        /* Mobile optimization */
        .card {
            border-radius: 15px;
            border: none;
        }
        @media (max-width: 576px) {
            .container { padding-left: 20px; padding-right: 20px; }
            h4 { font-size: 1.1rem; }
            .btn-lg { width: 100%; }
        }
        #progressBar { transition: width 0.5s ease-in-out; }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    
    <div class="container mt-4 mt-md-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                
                <% if (!user) { %>
                    <div class="text-center py-5">
                        <h2 class="mb-4 fw-bold text-dark">Google Drive Watermarker</h2>
                        <p class="text-muted mb-4">Easily apply watermarks to all PDFs in a folder.</p>
                        <a href="/auth/google" class="btn btn-primary btn-lg shadow-sm px-4">
                            Login with Google
                        </a>
                    </div>
                <% } else { %>
                    <div class="card shadow-sm p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                            <h4 class="mb-0 text-truncate me-2">Hi, <%= user.displayName %></h4>
                            <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
                        </div>

                        <form id="wmForm">
                            <input type="hidden" id="token" value="<%= user.token %>">
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Google Drive Folder URL</label>
                                <input type="text" id="folder" class="form-control form-control-lg" placeholder="Paste link here..." required>
                                <div class="form-text text-muted small">Make sure the folder contains PDF files.</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Upload Logo (PNG/JPG)</label>
                                <input type="file" id="logo" class="form-control" accept="image/*" required>
                            </div>

                            <button type="submit" id="submitBtn" class="btn btn-dark btn-lg w-100">
                                Start Watermarking
                            </button>
                        </form>

                        <div id="progressSection" class="mt-4 pt-3 border-top" style="display:none;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-bold small" id="statusMsg">Processing files...</span>
                                <span class="fw-bold small"><span id="percent">0</span>%</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                <% } %>

            </div>
        </div>
    </div>

    <footer class="mt-auto py-4 text-center border-top bg-white">
        <div class="container">
            <p class="text-muted mb-1 small">
                &copy; <span id="year"></span> IT Tech Square. All rights reserved.
            </p>
            <div class="small">
                <a href="/privacy" class="text-decoration-none me-3">Privacy Policy</a>
                <a href="/terms" class="text-decoration-none">Terms of Service</a>
            </div>
        </div>
    </footer>

    <script>
        // Set dynamic year
        document.getElementById('year').textContent = new Date().getFullYear();

        const form = document.getElementById('wmForm');
        if(form) {
            form.onsubmit = async (e) => {
                e.preventDefault();
                const btn = document.getElementById('submitBtn');
                const statusMsg = document.getElementById('statusMsg');
                
                btn.disabled = true;
                btn.innerText = "Connecting to Backend...";

                const formData = new FormData();
                formData.append('folder', document.getElementById('folder').value);
                formData.append('logo', document.getElementById('logo').files[0]);
                formData.append('token', document.getElementById('token').value);

                try {
                    const res = await fetch('/upload', { method: 'POST', body: formData });
                    const data = await res.json();

                    if (data.task_id) {
                        btn.innerText = "Task Started!";
                        document.getElementById('progressSection').style.display = 'block';
                        startPolling(data.task_id);
                    } else {
                        alert("Error: " + (data.error || "Unknown error"));
                        btn.disabled = false;
                        btn.innerText = "Start Watermarking";
                    }
                } catch (err) {
                    alert("Failed to reach server.");
                    btn.disabled = false;
                    btn.innerText = "Start Watermarking";
                }
            };
        }

        function startPolling(taskId) {
            const interval = setInterval(async () => {
                try {
                    const res = await fetch(`/status/${taskId}`);
                    const data = await res.json();

                    const bar = document.getElementById('progressBar');
                    const percentText = document.getElementById('percent');
                    const statusMsg = document.getElementById('statusMsg');

                    bar.style.width = data.progress + '%';
                    percentText.innerText = data.progress;

                    if (data.status === 'completed') {
                        clearInterval(interval);
                        statusMsg.innerText = "Success! PDFs Watermarked.";
                        statusMsg.classList.add('text-success');
                        bar.classList.remove('progress-bar-animated');
                        document.getElementById('submitBtn').innerText = "Process Finished";
                    }
                } catch (e) {
                    console.error("Polling error:", e);
                }
            }, 2000);
        }
    </script>
</body>
</html>